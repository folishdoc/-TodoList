{
  "productName": "Todolist",
  "version": "1.0.0",
  "identifier": "com.todolist.app",
  "build": {
    "frontendDist": "../todolist-frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Todolist - 个人待办事项管理",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "widget",
        "title": "待办小组件",
        "url": "index.html#/widget",
        "width": 320,
        "height": 450,
        "minWidth": 260,
        "minHeight": 300,
        "center": false,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src http://localhost:18080 http://ipc.localhost ipc:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "backend.jar"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
