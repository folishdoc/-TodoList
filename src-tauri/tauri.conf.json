{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri-apps-config-schema/refs/heads/master/tauri.conf.json",
  "productName": "Todolist",
  "version": "1.0.0",
  "identifier": "com.todolist.app",
  "build": {
    "frontendDist": "./frontend",
    "devUrl": "http://localhost:18080",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Todolist - 个人待办事项管理",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "closeBehavior": "minimize"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:18080; style-src 'self' 'unsafe-inline' http://localhost:18080; img-src 'self' data: http://localhost:18080; connect-src http://localhost:18080"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../jre/**",
      "../backend.jar"
    ],
    "nsis": {
      "installMode": "currentUser",
      "installerIcon": "icons/icon.ico",
      "shortcutName": "Todolist"
    }
  }
}
