# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 应用安全 ====================

# JWT 密钥（必须使用强密钥，至少 256 位）
# 生成方法：node -e "const crypto = require('crypto'); console.log(crypto.randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-here

# 个人访问 Token（前端和后端必须一致）
# 生成方法：node -e "const crypto = require('crypto'); console.log(crypto.randomBytes(32).toString('hex'))"
PERSONAL_TOKEN=your-strong-personal-token-here

# ==================== 数据库（MySQL） ====================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=your-strong-root-password-here

# MySQL 应用用户密码（todolist 用户）
MYSQL_PASSWORD=your-strong-app-password-here

# ==================== 域名（生产环境使用） ====================

# 你的域名（部署后替换）
DOMAIN_NAME=your-domain.com

# Let's Encrypt 证书邮箱（用于过期提醒）
SSL_EMAIL=admin@your-domain.com
