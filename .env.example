# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# JWT密钥（必须使用强密钥，至少256位）
# 生成方法：node -e "const crypto = require('crypto'); console.log(crypto.randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-here

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=your-database-password-here

# 个人访问Token（仅开发环境使用）
PERSONAL_TOKEN=dev-personal-token-2026-secure-key
